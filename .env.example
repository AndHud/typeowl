# TypeOwl Environment Variables
# Copy to .env and fill in your values

# Telegram Bot Token (get from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Web App URL (after deployment to Railway/Render/VPS)
# Example: https://typeowl-web.up.railway.app
WEB_APP_URL=https://your-deployed-url.railway.app

# Database (optional - for external DB)
# DATABASE_URL=sqlite:///typing_bot.db

# Port (set automatically by Railway/Render)
# PORT=8080